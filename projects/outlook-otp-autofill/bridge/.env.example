# Azure app registration (public client, no secret needed for device-code flow)
# Create one at https://entra.microsoft.com -> App registrations -> New registration
# Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
# Under Authentication: enable "Allow public client flows"
# Under API permissions: Microsoft Graph -> Delegated -> Mail.Read
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common

# Shared secret the extension must send in the X-Bridge-Token header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRIDGE_TOKEN=

# Local HTTP port the extension talks to
BRIDGE_PORT=4321

# How often to poll the inbox, in milliseconds
POLL_INTERVAL_MS=5000

# How long a code stays available after it was received, in seconds
CODE_TTL_SECONDS=120

# Optional: only consider mail from these senders (comma separated, case-insensitive substring match)
# Leave empty to consider all mail.
SENDER_ALLOWLIST=
